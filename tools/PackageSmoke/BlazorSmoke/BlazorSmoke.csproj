<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <DaventryVersion Condition="'$(DaventryVersion)' == ''">0.2.0-*</DaventryVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Daventry.Adl" Version="$(DaventryVersion)" />
    <PackageReference Include="Daventry.Agi" Version="$(DaventryVersion)" />
    <PackageReference Include="Daventry.Sci" Version="$(DaventryVersion)" />
    <PackageReference Include="Daventry.Host.Browser" Version="$(DaventryVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
  </ItemGroup>
</Project>
