<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- the packages carry XML documentation for the members that have it; the port is not
         documented member by member, so the missing-comment warning stays off. (The SDK derives
         the documentation file name before Directory.Build.targets is read, so this lives here.) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Daventry</Product>
    <Authors>Daventry contributors</Authors>
    <Copyright>Copyright (c) Daventry contributors. Portions derived from ScummVM, copyright the ScummVM Team.</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/jeffnyman/daventry</RepositoryUrl>
    <PackageProjectUrl>https://github.com/jeffnyman/daventry</PackageProjectUrl>
    <!-- dotnet pack -p:VersionSuffix=alpha.2 for the next prerelease; an empty suffix is a release -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>sierra;agi;sci;adventure;interpreter;scummvm;retro;games;blazor</PackageTags>
    <PackageReleaseNotes>First prerelease: AGI, preAGI and SCI0 through SCI2.1 interpreters, with SDL3 and browser hosts.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
