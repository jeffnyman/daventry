<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- the packages carry XML documentation. The missing-comment warning is off here, for the
         tests, the player and the page; Directory.Build.targets turns it back on for the libraries,
         whose public members are all documented. (The SDK derives the documentation file name
         before Directory.Build.targets is read, so this lives here.) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Daventry</Product>
    <Authors>Daventry contributors</Authors>
    <Copyright>Copyright (c) Daventry contributors. Portions derived from ScummVM, copyright the ScummVM Team.</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/jeffnyman/daventry</RepositoryUrl>
    <PackageProjectUrl>https://github.com/jeffnyman/daventry</PackageProjectUrl>
    <!-- dotnet pack -p:VersionSuffix=alpha.2 for the next prerelease; an empty suffix is a release -->
    <VersionPrefix>1.0.1</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <!-- nuget.org renders a package's README as Markdown alone, without the HTML the GitHub one
         uses: the packages carry NUGET.md, the same in Markdown, with links that work there -->
    <PackageReadmeFile>NUGET.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>sierra;agi;sci;adl;apple2;adventure;interpreter;scummvm;retro;games;blazor</PackageTags>
    <PackageReleaseNotes>The page on nuget.org, fixed: nuget.org renders a package's README as Markdown alone, and 1.0.0's, the one on GitHub, lost its title, badges, screenshots and author there with the HTML it uses. The packages now carry the same README in Markdown, with links that work on nuget.org, and its NuGet badge shows the stable version. Nothing else has changed: the player and the libraries are 1.0.0's, and so is the public API.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)NUGET.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
