<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- the packages carry XML documentation. The missing-comment warning is off here, for the
         tests, the player and the page; Directory.Build.targets turns it back on for the libraries,
         whose public members are all documented. (The SDK derives the documentation file name
         before Directory.Build.targets is read, so this lives here.) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Daventry</Product>
    <Authors>Daventry contributors</Authors>
    <Copyright>Copyright (c) Daventry contributors. Portions derived from ScummVM, copyright the ScummVM Team.</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/jeffnyman/daventry</RepositoryUrl>
    <PackageProjectUrl>https://github.com/jeffnyman/daventry</PackageProjectUrl>
    <!-- dotnet pack -p:VersionSuffix=alpha.2 for the next prerelease; an empty suffix is a release -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>sierra;agi;sci;adl;apple2;adventure;interpreter;scummvm;retro;games;blazor</PackageTags>
    <PackageReleaseNotes>First stable release. The public API is promised from here under semantic versioning: a breaking change waits for a new major version, and each release is checked against the last one published. Breaking since 0.3.0-alpha: AgiSoundEmulation moved to Daventry.Agi, SciSoundDevice to Daventry.Sci, Mt32Model and Mt32RomSet to Daventry.Audio; SaveCompression, FileSaveStore.MergeSubfolders, Surface8.Blit and Surface8.CopyFromShifted are internal; Engine.LoadingNotSupported is gone; BrowserGameLibrary.Confirm and Download moved to the new BrowserPage; BrowserHostOptions takes init like SdlHostOptions. Fixed: HeadlessHost gives only an engine's very first tick zero elapsed time. Runs AGI v2 and v3, the preAGI games, SCI0 to SCI3 and the Apple II Hi-Res Adventures, and gives the same output, to the byte, on Windows, Linux and macOS. What it does not do yet is in the README under Not yet.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
