<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Browser host for the Daventry interpreters: a canvas, Web Audio, keyboard and mouse, and saved games in local storage, as a Blazor component.</Description>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <InternalsVisibleTo Include="Daventry.Host.Browser.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Daventry.Core\Daventry.Core.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>
</Project>
