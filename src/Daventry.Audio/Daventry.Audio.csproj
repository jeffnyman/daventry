<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Audio mixer, sound chip emulation, the General MIDI SoundFont synthesiser and the MT-32 emulator (a port of Munt) shared by the Daventry interpreters, and WavWriter for a host that records their sound.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Daventry.Sci.Tests" />
    <InternalsVisibleTo Include="Daventry.Agi" />
    <InternalsVisibleTo Include="Daventry.Sci" />
    <InternalsVisibleTo Include="Daventry.Adl" />
    <InternalsVisibleTo Include="daventry" />
    <InternalsVisibleTo Include="Daventry.Agi.Tests" />
    <InternalsVisibleTo Include="Daventry.Adl.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Daventry.Core\Daventry.Core.csproj" />
    <PackageReference Include="MeltySynth" />
  </ItemGroup>
</Project>
